{
  "expo": {
    "name": "code-journey",
    "slug": "code-journey",
    "scheme": "myapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/aa.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./app/assets/mimo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/output-onlinepngtools.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.codejourney.codelearning"
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "97bded7a-4189-41e5-95c1-b67f0c6137be"
      }
    },
    "owner": "ahmadmudassir123"
  }
}
